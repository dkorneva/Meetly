{
  "expo": {
    "name": "Meetly",
    "slug": "meetly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meetly.app"
    },
    "android": {
      "package": "com.meetly.app"
    },
    "web": {
      "name": "Meetly",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "scheme": "meetly"
  }
}
