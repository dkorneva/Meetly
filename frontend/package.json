{
  "name": "meetly",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "check:fsd": "node scripts/check-fsd.cjs",
    "docs:signatures": "node scripts/generate-signatures.cjs",
    "docs": "npm run docs:signatures && typedoc"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.22",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "^58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "^58.0.2",
    "expo-sharing": "^58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^14.0.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "react-native-svg-transformer": "^1.5.3",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3"
  }
}
