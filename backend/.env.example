# Локальные значения храните в .env; этот файл содержит только примеры.
PORT=3000
DATABASE_URL="sqlserver://localhost\\SQLEXPRESS;database=Meetly;integratedSecurity=true;trustServerCertificate=true"
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:8081
# Только фон карты (OSM через Geoapify, бесплатный план); поиск ресторанов работает по БД.
GEOAPIFY_API_KEY=

