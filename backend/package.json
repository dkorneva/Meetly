{
  "name": "meetly-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "catalog:photos": "node scripts/catalog-photos.cjs",
    "catalog:fetch": "node scripts/fetch-catalog.cjs",
    "catalog:import": "node scripts/import-catalog.cjs",
    "test:unit": "npm run build && node --test --test-concurrency=1 test/domain.test.cjs test/error-responses.test.cjs test/map-tiles.test.cjs test/transactions.test.cjs test/photos.test.cjs test/catalog-http.test.cjs test/express-http.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "multer": "^2.0.2",
    "opening_hours": "^3.15.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "validator": "^13.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "@types/validator": "^13.15.0",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  }
}
